@PACKAGE_INIT@

# Boost is used header-only (Config / Predef) and is not installed with this
# package: find the consumer's copy. Set SHADER_MATH_BOOST_INCLUDE (and
# SHADER_MATH_BOOST_PREDEF_INCLUDE if Predef lives elsewhere) or
# CMAKE_PREFIX_PATH when they are not on the default include path.
find_path(SHADER_MATH_BOOST_INCLUDE boost/config.hpp)
find_path(SHADER_MATH_BOOST_PREDEF_INCLUDE boost/predef/hardware/simd.h
          HINTS ${SHADER_MATH_BOOST_INCLUDE})
if(NOT SHADER_MATH_BOOST_INCLUDE OR NOT SHADER_MATH_BOOST_PREDEF_INCLUDE OR
   NOT EXISTS "${SHADER_MATH_BOOST_PREDEF_INCLUDE}/boost/predef/hardware/simd.h")
    set(shader_math_FOUND FALSE)
    set(shader_math_NOT_FOUND_MESSAGE
        "shader_math needs the Boost.Config and Boost.Predef 1.60+ headers "
        "(boost/config.hpp, boost/predef/hardware/simd.h); set SHADER_MATH_BOOST_INCLUDE")
    return()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/shader_mathTargets.cmake")
# set(SHADER_MATH_FORCE_SCALAR ON) before find_package forces the scalar
# backend for every target linking shader_math::shader_math
if(SHADER_MATH_FORCE_SCALAR)
    set_property(TARGET shader_math::shader_math APPEND PROPERTY
        INTERFACE_COMPILE_DEFINITIONS SHADER_MATH_FORCE_SCALAR)
endif()
# set(SHADER_MATH_GLSL_STPQ ON) before find_package enables the GLSL .stpq
# swizzles for every target linking shader_math::shader_math
if(SHADER_MATH_GLSL_STPQ)
    set_property(TARGET shader_math::shader_math APPEND PROPERTY
        INTERFACE_COMPILE_DEFINITIONS SHADER_MATH_GLSL_STPQ)
endif()
set_property(TARGET shader_math::shader_math APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES
    "${SHADER_MATH_BOOST_INCLUDE}" "${SHADER_MATH_BOOST_PREDEF_INCLUDE}")

check_required_components(shader_math)
