{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"],
    "automerge": false
  },
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": false
  },
  "automerge": true,
  "platformAutomerge": false,
  "automergeStrategy": "merge-commit",
  "ignorePaths": [],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CMake FetchContent GIT_TAG (Boost header modules)",
      "managerFilePatterns": ["/(^|/)CMakeLists\\.txt$/"],
      "matchStrings": [
        "GIT_REPOSITORY https://github\\.com/(?<depName>boostorg/[^\\s/]+)\\.git\\s+GIT_TAG (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^boost-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "CMake FetchContent GIT_TAG (SDL_GPU demo: SDL3, ufbx)",
      "managerFilePatterns": ["/(^|/)CMakeLists\\.txt$/"],
      "matchStrings": [
        "GIT_REPOSITORY https://github\\.com/(?<depName>libsdl-org/SDL|ufbx/ufbx)\\.git\\s+GIT_TAG (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "ufbx test-asset URL (must match the FetchContent ufbx tag)",
      "managerFilePatterns": ["/(^|/)examples/sdl_gpu_skinning/test_external_assets\\.sh$/"],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/(?<depName>ufbx/ufbx)/(?<currentValue>v[^/\\s]+)/"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "Slang release of the interop job, with the sha256 of its Linux asset (Renovate recomputes the digest for the new release)",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "slang_tag: \"(?<currentValue>[^\"]+)\"\\s+slang_sha256: (?<currentDigest>[0-9a-f]{64})"
      ],
      "depNameTemplate": "shader-slang/slang",
      "datasourceTemplate": "github-release-attachments"
    },
    {
      "customType": "regex",
      "description": "DXC release of the interop jobs (CI looks up the asset and its digest in the immutable release)",
      "managerFilePatterns": ["/(^|/)\\.github/workflows/ci\\.yml$/"],
      "matchStrings": ["dxc_tag: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "microsoft/DirectXShaderCompiler",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Replacement proposals for renamed or deprecated packages are not a specific version, so skip minimumReleaseAge; they switch to another package without waiting, so a person merges them",
      "matchUpdateTypes": ["replacement"],
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "Bump Boost FetchContent modules together",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["boostorg/config", "boostorg/predef"],
      "groupName": "boost headers"
    },
    {
      "description": "SDL tags are release-X.Y.Z",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["libsdl-org/SDL"],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Bump the ufbx FetchContent tag and its test-asset URL together",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ufbx/ufbx"],
      "groupName": "ufbx"
    }
  ]
}
