{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "helpers:pinGitHubActionDigests"
  ],
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "vulnerabilityAlerts": {
    "labels": ["dependencies", "security"]
  },
  "osvVulnerabilityAlerts": true,
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "lockFileMaintenance": {
    "enabled": false
  },
  "ignorePaths": [],
  "customManagers": [
    {
      "customType": "regex",
      "description": "CMake FetchContent GIT_TAG (Boost header modules)",
      "managerFilePatterns": ["/(^|/)CMakeLists\\.txt$/"],
      "matchStrings": [
        "GIT_REPOSITORY https://github\\.com/(?<depName>boostorg/[^\\s/]+)\\.git\\s+GIT_TAG (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags",
      "versioningTemplate": "regex:^boost-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "customType": "regex",
      "description": "CMake FetchContent GIT_TAG (SDL_GPU demo: SDL3, ufbx)",
      "managerFilePatterns": ["/(^|/)CMakeLists\\.txt$/"],
      "matchStrings": [
        "GIT_REPOSITORY https://github\\.com/(?<depName>libsdl-org/SDL|ufbx/ufbx)\\.git\\s+GIT_TAG (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-tags"
    },
    {
      "customType": "regex",
      "description": "ufbx test-asset URL (must match the FetchContent ufbx tag)",
      "managerFilePatterns": ["/(^|/)examples/sdl_gpu_skinning/test_external_assets\\.sh$/"],
      "matchStrings": [
        "raw\\.githubusercontent\\.com/(?<depName>ufbx/ufbx)/(?<currentValue>v[^/\\s]+)/"
      ],
      "datasourceTemplate": "github-tags"
    }
  ],
  "packageRules": [
    {
      "description": "Replacement proposals for renamed or deprecated packages are not a specific version, so skip minimumReleaseAge",
      "matchUpdateTypes": ["replacement"],
      "minimumReleaseAge": null
    },
    {
      "description": "Bump Boost FetchContent modules together",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["boostorg/config", "boostorg/predef"],
      "groupName": "boost headers"
    },
    {
      "description": "SDL tags are release-X.Y.Z",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["libsdl-org/SDL"],
      "versioning": "regex:^release-(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      "description": "Bump the ufbx FetchContent tag and its test-asset URL together",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["ufbx/ufbx"],
      "groupName": "ufbx"
    }
  ]
}
